{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/genai-career/schemas/countries.schema.json",
  "title": "Country and City Scoring Model for GenAI Careers",
  "description": "Machine-readable source of truth for career/11-tracks/country-rankings.md (D-025). Covers destination countries from T0-35 and T0-36 plus cross-border remote evidence from T0-43, with 0-10 [lo, mid, hi] pillar intervals, grades, verified session line citations, city snapshots, and ranking lenses.",
  "type": "object",
  "required": [
    "schema",
    "as_of",
    "review_by",
    "fx_note",
    "description",
    "scoring_method",
    "pillars",
    "lenses",
    "countries"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "countries/1.0" },
    "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "review_by": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "fx_note": { "type": "string", "minLength": 20 },
    "description": { "type": "string", "minLength": 20 },
    "scoring_method": { "type": "string", "minLength": 40 },
    "analytical_notes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/analyticalNote" }
    },
    "pillars": {
      "type": "object",
      "required": [
        "demand",
        "pay_ppp",
        "net_pay",
        "access_india",
        "access_non_eu",
        "remote_reach",
        "ecosystem",
        "stability",
        "early_career"
      ],
      "additionalProperties": false,
      "properties": {
        "demand": { "$ref": "#/$defs/pillarMeta" },
        "pay_ppp": { "$ref": "#/$defs/pillarMeta" },
        "net_pay": { "$ref": "#/$defs/pillarMeta" },
        "access_india": { "$ref": "#/$defs/pillarMeta" },
        "access_non_eu": { "$ref": "#/$defs/pillarMeta" },
        "remote_reach": { "$ref": "#/$defs/pillarMeta" },
        "ecosystem": { "$ref": "#/$defs/pillarMeta" },
        "stability": { "$ref": "#/$defs/pillarMeta" },
        "early_career": { "$ref": "#/$defs/pillarMeta" }
      }
    },
    "lenses": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/lens" }
    },
    "countries": {
      "type": "array",
      "minItems": 15,
      "items": { "$ref": "#/$defs/country" }
    }
  },
  "$defs": {
    "grade": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "M"]
    },
    "pillarMeta": {
      "type": "object",
      "required": ["label", "description", "scale"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 2 },
        "description": { "type": "string", "minLength": 10 },
        "scale": { "type": "string", "minLength": 10 }
      }
    },
    "analyticalNote": {
      "type": "object",
      "required": ["title", "body", "grade", "source"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 4 },
        "body": { "type": "string", "minLength": 20 },
        "grade": { "$ref": "#/$defs/grade" },
        "source": { "type": "string", "minLength": 5 }
      }
    },
    "uniformGrossTax": {
      "type": "object",
      "required": ["gross_basis", "net_display", "deduction_pct", "grade", "source"],
      "additionalProperties": false,
      "properties": {
        "gross_basis": { "type": "string", "enum": ["EUR 100,000", "USD 100,000"] },
        "net_display": { "type": "string", "minLength": 3 },
        "deduction_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "grade": { "$ref": "#/$defs/grade" },
        "source": { "type": "string", "minLength": 5 }
      }
    },
    "lens": {
      "type": "object",
      "required": ["id", "name", "description", "weights"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 4 },
        "description": { "type": "string", "minLength": 15 },
        "weights": {
          "type": "object",
          "required": [
            "demand",
            "pay_ppp",
            "net_pay",
            "access_india",
            "access_non_eu",
            "remote_reach",
            "ecosystem",
            "stability",
            "early_career"
          ],
          "additionalProperties": false,
          "properties": {
            "demand": { "type": "number", "minimum": 0, "maximum": 1 },
            "pay_ppp": { "type": "number", "minimum": 0, "maximum": 1 },
            "net_pay": { "type": "number", "minimum": 0, "maximum": 1 },
            "access_india": { "type": "number", "minimum": 0, "maximum": 1 },
            "access_non_eu": { "type": "number", "minimum": 0, "maximum": 1 },
            "remote_reach": { "type": "number", "minimum": 0, "maximum": 1 },
            "ecosystem": { "type": "number", "minimum": 0, "maximum": 1 },
            "stability": { "type": "number", "minimum": 0, "maximum": 1 },
            "early_career": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "pillarScore": {
      "type": "object",
      "required": ["range", "grade", "basis"],
      "additionalProperties": false,
      "properties": {
        "range": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number", "minimum": 0, "maximum": 10 }
        },
        "grade": { "$ref": "#/$defs/grade" },
        "basis": { "type": "string", "minLength": 15 }
      }
    },
    "taxRegime": {
      "type": "object",
      "required": ["name", "summary", "grade", "source"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "summary": { "type": "string", "minLength": 10 },
        "grade": { "$ref": "#/$defs/grade" },
        "source": { "type": "string", "minLength": 5 }
      }
    },
    "citySnapshot": {
      "type": "object",
      "required": [
        "name",
        "ref_gross_local",
        "net_annual_usd_k",
        "rent_1br_centre_usd_mo",
        "disposable_annual_usd_k",
        "basis_note",
        "grade",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "ref_gross_local": { "type": "string", "minLength": 3 },
        "net_annual_usd_k": { "type": ["number", "null"], "minimum": 0 },
        "regime_net_annual_usd_k": { "type": ["number", "null"], "minimum": 0 },
        "rent_1br_centre_usd_mo": { "type": ["number", "null"], "minimum": 0 },
        "rent_1br_outside_usd_mo": { "type": ["number", "null"], "minimum": 0 },
        "living_excl_rent_usd_mo": { "type": ["number", "null"], "minimum": 0 },
        "disposable_annual_usd_k": { "type": ["number", "null"], "minimum": 0 },
        "basis_note": { "type": "string", "minLength": 5 },
        "grade": { "$ref": "#/$defs/grade" },
        "source": { "type": "string", "minLength": 5 }
      }
    },
    "country": {
      "type": "object",
      "required": [
        "id",
        "iso2",
        "name",
        "region",
        "currency",
        "working_language",
        "tz_overlap_india_std_h",
        "tz_overlap_india_dst_h",
        "incoming_tax_regime",
        "access_summary",
        "caveat",
        "cities",
        "pillars"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]{2}$" },
        "iso2": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "name": { "type": "string", "minLength": 2 },
        "region": {
          "type": "string",
          "enum": ["Americas", "Europe & Israel", "Gulf", "India & Asia-Pacific"]
        },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "working_language": { "type": "string", "minLength": 4 },
        "tz_overlap_india_std_h": { "type": "number", "minimum": 0, "maximum": 9 },
        "tz_overlap_india_dst_h": { "type": "number", "minimum": 0, "maximum": 9 },
        "incoming_tax_regime": { "$ref": "#/$defs/taxRegime" },
        "uniform_gross_tax": { "$ref": "#/$defs/uniformGrossTax" },
        "access_summary": { "type": "string", "minLength": 15 },
        "caveat": { "type": "string", "minLength": 15 },
        "cities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/citySnapshot" }
        },
        "pillars": {
          "type": "object",
          "required": [
            "demand",
            "pay_ppp",
            "net_pay",
            "access_india",
            "access_non_eu",
            "remote_reach",
            "ecosystem",
            "stability",
            "early_career"
          ],
          "additionalProperties": false,
          "properties": {
            "demand": { "$ref": "#/$defs/pillarScore" },
            "pay_ppp": { "$ref": "#/$defs/pillarScore" },
            "net_pay": { "$ref": "#/$defs/pillarScore" },
            "access_india": { "$ref": "#/$defs/pillarScore" },
            "access_non_eu": { "$ref": "#/$defs/pillarScore" },
            "remote_reach": { "$ref": "#/$defs/pillarScore" },
            "ecosystem": { "$ref": "#/$defs/pillarScore" },
            "stability": { "$ref": "#/$defs/pillarScore" },
            "early_career": { "$ref": "#/$defs/pillarScore" }
          }
        }
      }
    }
  }
}
