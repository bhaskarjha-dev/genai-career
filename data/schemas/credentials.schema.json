{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genai-career.local/schemas/credentials.schema.json",
  "title": "GenAI Career Credentials Registry",
  "description": "Schema for data/credentials.json (schema credentials/1.0, decision D-026). Uses only the JSON Schema subset enforced by scripts/common.py.",
  "type": "object",
  "required": [
    "schema",
    "as_of",
    "description",
    "provisional_scope",
    "criteria",
    "channel_lenses",
    "role_families",
    "credentials"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "credentials/1.0"
    },
    "as_of": {
      "$ref": "#/$defs/date"
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "provisional_scope": {
      "type": "object",
      "required": [
        "completed_sessions",
        "reconciled_sessions",
        "deferred_sessions",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "completed_sessions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^T[0-3]-\\d{2}$"
          },
          "uniqueItems": true
        },
        "reconciled_sessions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^T[0-3]-\\d{2}$"
          },
          "uniqueItems": true
        },
        "deferred_sessions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^T[0-3]-\\d{2}$"
          },
          "uniqueItems": true
        },
        "note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "criteria": {
      "type": "object",
      "required": [
        "hiring_signal",
        "channel_value",
        "rigour",
        "skill_alignment",
        "currency",
        "cost_efficiency"
      ],
      "additionalProperties": false,
      "properties": {
        "hiring_signal": {
          "$ref": "#/$defs/criterionDef"
        },
        "channel_value": {
          "$ref": "#/$defs/criterionDef"
        },
        "rigour": {
          "$ref": "#/$defs/criterionDef"
        },
        "skill_alignment": {
          "$ref": "#/$defs/criterionDef"
        },
        "currency": {
          "$ref": "#/$defs/criterionDef"
        },
        "cost_efficiency": {
          "$ref": "#/$defs/criterionDef"
        }
      }
    },
    "channel_lenses": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "weights",
          "access_filter",
          "group_filter",
          "kind_filter",
          "channel_filter"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "description": {
            "type": "string",
            "minLength": 15
          },
          "weights": {
            "type": "object",
            "required": [
              "hiring_signal",
              "channel_value",
              "rigour",
              "skill_alignment",
              "currency",
              "cost_efficiency"
            ],
            "additionalProperties": false,
            "properties": {
              "hiring_signal": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "channel_value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "rigour": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "skill_alignment": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "currency": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "cost_efficiency": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "access_filter": {
            "type": ["array", "null"],
            "items": {
              "$ref": "#/$defs/access"
            },
            "uniqueItems": true
          },
          "group_filter": {
            "type": ["array", "null"],
            "items": {
              "$ref": "#/$defs/group"
            },
            "uniqueItems": true
          },
          "kind_filter": {
            "type": ["array", "null"],
            "items": {
              "$ref": "#/$defs/kind"
            },
            "uniqueItems": true
          },
          "channel_filter": {
            "type": ["array", "null"],
            "items": {
              "$ref": "#/$defs/channel"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "role_families": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/family"
          },
          "name": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "credentials": {
      "type": "array",
      "minItems": 37,
      "items": {
        "$ref": "#/$defs/credential"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "criterionDef": {
      "type": "object",
      "required": ["weight", "description"],
      "additionalProperties": false,
      "properties": {
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "description": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "group": {
      "type": "string",
      "enum": [
        "hyperscalers",
        "frontier-labs",
        "courses-universities-india",
        "data-enterprise",
        "gpu-infra-oss",
        "dev-tools-agentic",
        "governance-security-audit"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "proctored-exam",
        "hands-on-exam",
        "hybrid-exam",
        "assessed-cert",
        "completion-cert",
        "accreditation",
        "recognition",
        "graduate-cert"
      ]
    },
    "level": {
      "type": "string",
      "enum": [
        "foundational",
        "associate",
        "intermediate",
        "professional",
        "specialist",
        "executive",
        "recognition",
        "unclassified"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "beta",
        "announced",
        "retired",
        "retiring"
      ]
    },
    "access": {
      "type": "string",
      "enum": [
        "open",
        "partner-gated",
        "invite-only",
        "employer-gated",
        "nomination-only"
      ]
    },
    "family": {
      "type": "string",
      "enum": [
        "applied-ai-eng",
        "ml-eng-science",
        "fde-solutions",
        "ai-infra-platform",
        "data-enterprise-ai",
        "eval-safety-security",
        "governance-risk-audit",
        "product-program-exec"
      ]
    },
    "channel": {
      "type": "string",
      "enum": [
        "product",
        "services-partners",
        "gcc",
        "governance-assurance",
        "enterprise-platform",
        "public-sector",
        "learning-only"
      ]
    },
    "scoreTriple": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 10
      }
    },
    "nullableScoreTriple": {
      "type": ["array", "null"],
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 10
      }
    },
    "credential": {
      "type": "object",
      "required": [
        "id",
        "name",
        "exam_code",
        "issuer",
        "group",
        "kind",
        "level",
        "state",
        "access",
        "provisional_pending_rp2",
        "format",
        "proctored",
        "fee_usd",
        "fee_local",
        "validity_months",
        "prep_hours",
        "families",
        "channels",
        "scores",
        "grade",
        "source",
        "as_of",
        "ttl",
        "url",
        "coi",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "exam_code": {
          "type": ["string", "null"]
        },
        "issuer": {
          "type": "string",
          "minLength": 2
        },
        "group": {
          "$ref": "#/$defs/group"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "level": {
          "$ref": "#/$defs/level"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "access": {
          "$ref": "#/$defs/access"
        },
        "provisional_pending_rp2": {
          "type": "boolean"
        },
        "format": {
          "type": "string",
          "minLength": 3
        },
        "proctored": {
          "type": ["boolean", "null"]
        },
        "fee_usd": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "fee_local": {
          "type": ["string", "null"]
        },
        "validity_months": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "prep_hours": {
          "type": ["array", "null"],
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "families": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/family"
          },
          "uniqueItems": true
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/channel"
          },
          "uniqueItems": true
        },
        "scores": {
          "type": "object",
          "required": [
            "hiring_signal",
            "channel_value",
            "rigour",
            "skill_alignment",
            "currency",
            "cost_efficiency"
          ],
          "additionalProperties": false,
          "properties": {
            "hiring_signal": {
              "$ref": "#/$defs/nullableScoreTriple"
            },
            "channel_value": {
              "$ref": "#/$defs/scoreTriple"
            },
            "rigour": {
              "$ref": "#/$defs/scoreTriple"
            },
            "skill_alignment": {
              "$ref": "#/$defs/scoreTriple"
            },
            "currency": {
              "$ref": "#/$defs/scoreTriple"
            },
            "cost_efficiency": {
              "$ref": "#/$defs/scoreTriple"
            }
          }
        },
        "grade": {
          "type": "string",
          "enum": ["A", "B", "C", "D", "M"]
        },
        "source": {
          "type": "string",
          "pattern": "^T[0-3]-\\d{2} L\\d+"
        },
        "as_of": {
          "$ref": "#/$defs/date"
        },
        "ttl": {
          "type": "string",
          "enum": ["V0", "V1", "V2", "V3", "V4"]
        },
        "url": {
          "type": ["string", "null"],
          "pattern": "^https://"
        },
        "coi": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "minLength": 10
        }
      }
    }
  }
}
