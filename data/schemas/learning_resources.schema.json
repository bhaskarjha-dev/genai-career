{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "learning_resources.schema.json",
 "title": "Rated GenAI learning resources catalogue",
 "description": "Schema for data/learning_resources.json (decision D-027): sceptically rated GenAI learning resources (documentation, courses, lectures, books, specifications, paid cohorts and bootcamps) mapped to the 12 canonical role families, with T0-68 rubric scores, hard gates G1-G5, refund checks, COI flags, read-depth disclosures and dated source lines. Uses only the JSON Schema subset enforced by scripts/common.py schema_errors(). Cross-record rules (unique IDs, valid ISO dates, family slugs, role slugs, and session line references) are checked in scripts/build_learning_resources.py.",
 "type": "object",
 "required": ["schema", "as_of", "review_by", "description", "basis", "rubric", "families", "resources"],
 "additionalProperties": false,
 "properties": {
  "schema": {"const": "learning-resources/1.0"},
  "as_of": {"$ref": "#/$defs/date"},
  "review_by": {"$ref": "#/$defs/date"},
  "description": {"type": "string", "minLength": 20},
  "basis": {"type": "string", "minLength": 20},
  "rubric": {
   "type": "object",
   "required": ["formula", "weights", "bands", "gates"],
   "additionalProperties": false,
   "properties": {
    "formula": {"type": "string", "minLength": 5, "maxLength": 120},
    "weights": {
     "type": "object",
     "required": ["authority", "currency", "hands_on", "role_fit", "cost"],
     "additionalProperties": false,
     "properties": {
      "authority": {"type": "integer", "minimum": 1, "maximum": 100},
      "currency": {"type": "integer", "minimum": 1, "maximum": 100},
      "hands_on": {"type": "integer", "minimum": 1, "maximum": 100},
      "role_fit": {"type": "integer", "minimum": 1, "maximum": 100},
      "cost": {"type": "integer", "minimum": 1, "maximum": 100}
     }
    },
    "bands": {
     "type": "object",
     "required": ["use", "use_with_care", "watch", "avoid"],
     "additionalProperties": false,
     "properties": {
      "use": {"type": "string", "minLength": 3, "maxLength": 160},
      "use_with_care": {"type": "string", "minLength": 3, "maxLength": 160},
      "watch": {"type": "string", "minLength": 3, "maxLength": 160},
      "avoid": {"type": "string", "minLength": 3, "maxLength": 160}
     }
    },
    "gates": {
     "type": "object",
     "required": ["G1", "G2", "G3", "G4", "G5"],
     "additionalProperties": false,
     "properties": {
      "G1": {"type": "string", "minLength": 10, "maxLength": 260},
      "G2": {"type": "string", "minLength": 10, "maxLength": 260},
      "G3": {"type": "string", "minLength": 10, "maxLength": 260},
      "G4": {"type": "string", "minLength": 10, "maxLength": 260},
      "G5": {"type": "string", "minLength": 10, "maxLength": 260}
     }
    }
   }
  },
  "families": {
   "type": "object",
   "propertyNames": {"pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
   "additionalProperties": {"$ref": "#/$defs/family"}
  },
  "resources": {
   "type": "array",
   "minItems": 1,
   "items": {"$ref": "#/$defs/resource"}
  }
 },
 "$defs": {
  "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
  "ttl": {"enum": ["V0", "V1", "V2", "V3", "V4", "V5", "V6"]},
  "grade": {"enum": ["A", "B", "C", "D"]},
  "source_ref": {
   "type": "string",
   "pattern": "^T[0-3]-\\d{2} L\\d+(-L?\\d+)?(, L\\d+(-L?\\d+)?)*(; T[0-3]-\\d{2} L\\d+(-L?\\d+)?(, L\\d+(-L?\\d+)?)*)*$"
  },
  "family": {
   "type": "object",
   "required": ["label", "roles", "minimal_free", "minimal_paid"],
   "additionalProperties": false,
   "properties": {
    "label": {"type": "string", "minLength": 3, "maxLength": 80},
    "roles": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}
    },
    "minimal_free": {"type": "string", "minLength": 10, "maxLength": 360},
    "minimal_paid": {"type": "string", "minLength": 5, "maxLength": 360}
   }
  },
  "resource": {
   "type": "object",
   "required": [
    "id", "name", "provider", "url", "kind", "verdict", "is_free", "cost_display",
    "hours", "level", "last_update", "families", "score", "gates", "coi",
    "read_depth", "outcome_evidence", "refund_terms", "grade", "source", "as_of", "ttl", "note"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64},
    "name": {"type": "string", "minLength": 3, "maxLength": 160},
    "provider": {"type": "string", "minLength": 2, "maxLength": 120},
    "url": {"type": "string", "pattern": "^https://\\S+$"},
    "kind": {
     "enum": [
      "free-course", "free-cohort-course", "university-course", "lecture-series",
      "documentation", "specification", "guidance", "framework", "articles", "book",
      "checklist", "curriculum", "learning-platform", "paid-course", "paid-cohort",
      "paid-programme", "paid-bootcamp", "isa-bootcamp", "paid-certification", "executive-programme"
     ]
    },
    "verdict": {"enum": ["use", "use-with-care", "watch", "avoid"]},
    "is_free": {"type": "boolean"},
    "cost_display": {"type": "string", "minLength": 2, "maxLength": 180},
    "hours": {"type": ["string", "null"], "maxLength": 120},
    "level": {"type": ["string", "null"], "maxLength": 80},
    "last_update": {"type": ["string", "null"], "maxLength": 140},
    "families": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}
    },
    "score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
    "gates": {
     "type": "array",
     "uniqueItems": true,
     "items": {"enum": ["G1", "G2", "G3", "G4", "G5"]}
    },
    "coi": {"type": "boolean"},
    "read_depth": {"enum": ["full-read", "extract-only", "recalled"]},
    "outcome_evidence": {"type": "string", "minLength": 2, "maxLength": 260},
    "refund_terms": {"type": ["string", "null"], "maxLength": 240},
    "grade": {"$ref": "#/$defs/grade"},
    "source": {"$ref": "#/$defs/source_ref"},
    "as_of": {"$ref": "#/$defs/date"},
    "ttl": {"$ref": "#/$defs/ttl"},
    "note": {"type": ["string", "null"], "maxLength": 420}
   }
  }
 }
}
