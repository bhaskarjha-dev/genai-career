{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bhaskarjha-dev/genai-career/data/schemas/posting_skill_shares.schema.json",
  "title": "Posting skill shares",
  "description": "Schema for data/posting_skill_shares.json: dated snapshots of the skills job postings name, by posting title. It uses only the JSON Schema subset that scripts/common.py schema_errors() implements. scripts/build_skills.py checks that every JD share in data/skills_ontology.json matches its title's row here.",
  "type": "object",
  "required": ["schema", "description", "snapshots"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "posting-skill-shares/1.0"},
    "description": {"type": "string", "minLength": 1},
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source", "retrieved", "grade", "basis", "expiry", "titles"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "source": {"type": "string", "minLength": 1},
          "retrieved": {"type": "string", "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"},
          "grade": {"enum": ["A", "B", "C", "D"]},
          "basis": {"type": "string", "minLength": 1},
          "expiry": {"type": "string", "minLength": 1},
          "titles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["title", "skills"],
              "additionalProperties": false,
              "properties": {
                "title": {"type": "string", "minLength": 1},
                "qualifier": {"type": "string", "minLength": 1},
                "skills": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["name", "share"],
                    "additionalProperties": false,
                    "properties": {
                      "name": {"type": "string", "minLength": 1},
                      "share": {"type": "number", "minimum": 0, "maximum": 100}
                    }
                  }
                },
                "notes": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
