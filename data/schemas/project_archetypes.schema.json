{
 "type": "object",
 "required": ["schema", "as_of", "description", "basis", "archetypes"],
 "additionalProperties": false,
 "properties": {
  "schema": {"const": "project-archetypes/1.1"},
  "as_of": {"$ref": "#/$defs/date"},
  "review_by": {"$ref": "#/$defs/date"},
  "description": {"$ref": "#/$defs/long_text"},
  "basis": {"$ref": "#/$defs/long_text"},
  "archetypes": {
   "type": "object",
   "propertyNames": {"pattern": "^P[1-9][0-9]*$"},
   "additionalProperties": {"$ref": "#/$defs/archetype"}
  }
 },
 "$defs": {
  "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
  "long_text": {"type": "string", "minLength": 20, "pattern": "^[^|\"\\n]+$"},
  "item": {"type": "string", "minLength": 10, "maxLength": 320, "pattern": "^[^|\"\\n]+$"},
  "archetype": {
   "type": "object",
   "required": ["name", "skills", "problem", "build", "evidence", "verifiability", "effort", "compute", "interview_archetypes", "pitfalls", "sources"],
   "additionalProperties": false,
   "properties": {
    "name": {"type": "string", "minLength": 3, "maxLength": 120, "pattern": "^[^|\"\\n]+$"},
    "skills": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
    "problem": {"type": "string", "minLength": 40, "maxLength": 640, "pattern": "^[^|\"\\n]+$"},
    "build": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/item"}},
    "evidence": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/item"}},
    "verifiability": {"enum": ["V1", "V2", "V3"]},
    "effort": {"enum": ["S", "M", "L"]},
    "spec": {"enum": ["R1", "R2", "R3", "R4"]},
    "compute": {"$ref": "#/$defs/item"},
    "interview_archetypes": {"type": "array", "items": {"type": "string", "pattern": "^A([1-9]|1[0-5])$"}},
    "pitfalls": {"type": "array", "minItems": 2, "items": {"type": "string", "maxLength": 80, "pattern": "^AP-[1-9] [^|\"\\n]+$"}},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 6, "pattern": "^(T[0-2]-[0-9]{2}[ .][^|\"\\n]+|career/[0-9]{2}-[a-z0-9-]+/[a-z0-9-]+\\.md( §[0-9.]+|#[a-z0-9-]+)?)$"}}
   }
  }
 }
}
