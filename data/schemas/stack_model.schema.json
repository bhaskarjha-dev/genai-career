{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "stack_model.schema.json",
 "title": "GenAI stack model (layers, planes, category map and specialisations)",
 "description": "Schema for data/stack_model.json (decision D-015). Checked by scripts/validate_docs.py and scripts/build_role_map.py; referential rules (every ontology category mapped exactly once, every specialisation's roles and skills known) are checked in code.",
 "type": "object",
 "required": ["schema", "as_of", "description", "basis", "not_a_pay_model", "layers", "planes", "cross_cutting_categories", "specialisations"],
 "additionalProperties": false,
 "properties": {
  "schema": {"const": "stack-model/1.0"},
  "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
  "description": {"type": "string", "minLength": 20},
  "basis": {"type": "string", "minLength": 20},
  "not_a_pay_model": {"type": "string", "minLength": 20},
  "layers": {
   "type": "object",
   "propertyNames": {"pattern": "^L[1-6]$"},
   "additionalProperties": {"$ref": "#/$defs/area"}
  },
  "planes": {
   "type": "object",
   "propertyNames": {"pattern": "^[a-z]+$"},
   "additionalProperties": {"$ref": "#/$defs/area"}
  },
  "cross_cutting_categories": {"type": "array", "items": {"type": "string", "minLength": 2}},
  "specialisations": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["id", "name", "where", "home", "skills", "catalog"],
    "additionalProperties": false,
    "properties": {
     "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
     "name": {"type": "string", "minLength": 3},
     "where": {"type": "string", "pattern": "^(L[1-6]|[a-z]+)$"},
     "home": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
     "skills": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
     "catalog": {"type": "string", "minLength": 10}
    }
   }
  }
 },
 "$defs": {
  "area": {
   "type": "object",
   "required": ["name", "covers", "categories"],
   "additionalProperties": false,
   "properties": {
    "name": {"type": "string", "minLength": 3},
    "covers": {"type": "string", "minLength": 10},
    "categories": {"type": "array", "items": {"type": "string", "minLength": 2}}
   }
  }
 }
}
