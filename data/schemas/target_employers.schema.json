{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "target_employers.schema.json",
 "title": "Target GenAI employers and sponsor registers",
 "description": "Schema for data/target_employers.json (decision D-024): vetted target employers with ATS vendor, public board URL, sponsorship evidence, remote policy, India presence, evidence grades and source lines, plus official sponsor-register pointers. Uses only the JSON Schema subset enforced by scripts/common.py schema_errors(). Cross-record rules (unique IDs, valid ISO dates, employer_type keys, and session line references) are checked in scripts/build_employers.py.",
 "type": "object",
 "required": ["schema", "as_of", "description", "basis", "employer_types", "sponsor_registers", "employers"],
 "additionalProperties": false,
 "properties": {
  "schema": {"const": "target-employers/1.0"},
  "as_of": {"$ref": "#/$defs/date"},
  "description": {"type": "string", "minLength": 20},
  "basis": {"type": "string", "minLength": 20},
  "employer_types": {
   "type": "object",
   "required": ["frontier-lab", "big-tech", "ai-startup", "enterprise", "it-services", "public-sector", "other"],
   "additionalProperties": false,
   "properties": {
    "frontier-lab": {"$ref": "#/$defs/type_meta"},
    "big-tech": {"$ref": "#/$defs/type_meta"},
    "ai-startup": {"$ref": "#/$defs/type_meta"},
    "enterprise": {"$ref": "#/$defs/type_meta"},
    "it-services": {"$ref": "#/$defs/type_meta"},
    "public-sector": {"$ref": "#/$defs/type_meta"},
    "other": {"$ref": "#/$defs/type_meta"}
   }
  },
  "sponsor_registers": {
   "type": "array",
   "minItems": 1,
   "items": {"$ref": "#/$defs/sponsor_register"}
  },
  "employers": {
   "type": "array",
   "minItems": 1,
   "items": {"$ref": "#/$defs/employer"}
  }
 },
 "$defs": {
  "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
  "ttl": {"enum": ["V0", "V1", "V2", "V3", "V4", "V5", "V6"]},
  "grade": {"enum": ["A", "B", "C", "D"]},
  "source_ref": {
   "type": "string",
   "pattern": "^T[0-3]-\\d{2} L\\d+(-L?\\d+)?(, L\\d+(-L?\\d+)?)*(; T[0-3]-\\d{2} L\\d+(-L?\\d+)?(, L\\d+(-L?\\d+)?)*)*$"
  },
  "type_meta": {
   "type": "object",
   "required": ["label", "description"],
   "additionalProperties": false,
   "properties": {
    "label": {"type": "string", "minLength": 2, "maxLength": 80},
    "description": {"type": "string", "minLength": 10, "maxLength": 260}
   }
  },
  "open_roles": {
   "type": ["object", "null"],
   "required": ["date", "filter"],
   "additionalProperties": false,
   "properties": {
    "count": {"type": ["integer", "null"], "minimum": 0},
    "lo": {"type": ["integer", "null"], "minimum": 0},
    "hi": {"type": ["integer", "null"], "minimum": 0},
    "date": {"$ref": "#/$defs/date"},
    "filter": {"type": "string", "minLength": 3, "maxLength": 240}
   }
  },
  "sponsor_register": {
   "type": "object",
   "required": ["id", "name", "jurisdiction", "url", "cadence", "holds", "limits", "grade", "source", "as_of", "ttl"],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60},
    "name": {"type": "string", "minLength": 2, "maxLength": 140},
    "jurisdiction": {"type": "string", "minLength": 2, "maxLength": 40},
    "url": {"type": "string", "pattern": "^https://\\S+$"},
    "cadence": {"type": "string", "minLength": 2, "maxLength": 120},
    "holds": {"type": "string", "minLength": 10, "maxLength": 260},
    "limits": {"type": "string", "minLength": 5, "maxLength": 260},
    "grade": {"$ref": "#/$defs/grade"},
    "source": {"$ref": "#/$defs/source_ref"},
    "as_of": {"$ref": "#/$defs/date"},
    "ttl": {"$ref": "#/$defs/ttl"}
   }
  },
  "employer": {
   "type": "object",
   "required": [
    "id", "name", "employer_type", "hq", "regions", "ats", "board_url",
    "sponsorship", "remote_policy", "india_presence", "grade", "source", "as_of", "ttl", "note"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60},
    "name": {"type": "string", "minLength": 2, "maxLength": 120},
    "employer_type": {
     "enum": ["frontier-lab", "big-tech", "ai-startup", "enterprise", "it-services", "public-sector", "other"]
    },
    "hq": {"type": ["string", "null"], "minLength": 2, "maxLength": 100},
    "regions": {
     "type": "array",
     "uniqueItems": true,
     "items": {"type": "string", "pattern": "^[A-Z]{2}$"}
    },
    "ats": {
     "type": ["string", "null"],
     "enum": ["Greenhouse", "Ashby", "Lever", "Workable", "Workday", "Custom", null]
    },
    "ats_slug": {"type": ["string", "null"], "minLength": 1, "maxLength": 80},
    "board_url": {"type": ["string", "null"], "pattern": "^https://\\S+$"},
    "open_roles": {"$ref": "#/$defs/open_roles"},
    "sponsorship": {"type": ["string", "null"], "maxLength": 280},
    "remote_policy": {"type": ["string", "null"], "maxLength": 240},
    "india_presence": {"type": ["string", "null"], "maxLength": 280},
    "grade": {"$ref": "#/$defs/grade"},
    "source": {"$ref": "#/$defs/source_ref"},
    "as_of": {"$ref": "#/$defs/date"},
    "ttl": {"$ref": "#/$defs/ttl"},
    "note": {"type": ["string", "null"], "maxLength": 420}
   }
  }
 }
}
